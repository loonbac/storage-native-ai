+// [CYCLE2-E002D] sched eval callback: capture expert indices by node NAME at copy time
+static bool llama_moe_trace_cb(struct ggml_tensor * t, bool ask, void * user_data) {
+    if (!ask || t == nullptr) return true;
+    const char * name = ggml_get_name(t);
+    if (name == nullptr || strncmp(name, "moe_trace_persist", 17) != 0) return true;
+    ggml_tensor * src0 = t->src[0];
+    if (src0 == nullptr || src0->data == nullptr) return true;
+    const int32_t il = atoi(name + 18);
+    const int64_t ne0 = src0->ne[0];
+    const int64_t ne1 = src0->ne[1];
+    const size_t nbytes = ggml_nbytes(src0);
+    if (ne0 <= 0 || ne1 <= 0 || nbytes != (size_t)(ne0 * ne1 * sizeof(int32_t))) return true;
+    std::vector<int32_t> idx((size_t)(ne0 * ne1) + 1);
+    idx[0] = (int32_t) ne0;
+    ggml_backend_tensor_get(src0, idx.data() + 1, 0, nbytes);
+    llm_graph_result::moe_trace_state * st = (llm_graph_result::moe_trace_state *) user_data;
+    if (st) st->collected.emplace_back(il, std::move(idx));
+    return true;
+}
+
 llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, llm_graph_type gtype, llama_memory_context_i * mctx, ggml_status & ret) {
+    // [CYCLE2-E002D] open trace file early so graph construction can capture expert indices
+    if (g_llama_moe_trace == nullptr) {
+        const char * trace_path = getenv("LLAMA_TRACE_MOE");
+        if (trace_path && trace_path[0] != '\0') {
+            g_llama_moe_trace = fopen(trace_path, "a");
+        }
+    }
+
     if (mctx && !mctx->apply()) {
         LLAMA_LOG_ERROR("%s: failed to apply memory context\n", __func__);
         ret = GGML_STATUS_FAILED;
@@ -1332,7 +1360,7 @@ llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, ll
     // in order to correctly reuse a graph, it's full topology has to be uniquely determined by these parameters
     const auto gparams = graph_params(res, ubatch, mctx, gtype);
 
-    if (!graph_reuse_disable && res->can_reuse(gparams)) {
+    if (!graph_reuse_disable && g_llama_moe_trace == nullptr && res->can_reuse(gparams)) {
         //LLAMA_LOG_DEBUG("%s: reusing previous graph\n", __func__);
 
         // with pipeline parallelism, the previous graph_compute_async may still be running
@@ -1353,6 +1381,13 @@ llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, ll
 
         gf = model.build_graph(gparams);
 
+        // [CYCLE2-E002D] register tracing callback after graph build (captures by node name)
+        if (g_llama_moe_trace != nullptr) {
+            res->moe_trace.collected.clear();
+            res->moe_trace.pending.clear();
+            ggml_backend_sched_set_eval_callback(sched.get(), llama_moe_trace_cb, &res->moe_trace);
+        }
+
         //LLAMA_LOG_INFO("graph build time: %.3f ms\n", (ggml_time_us() - t_start_us)/1000.0);
 
         if (!gf) {
@@ -1387,6 +1422,32 @@ llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, ll
 
     ret = GGML_STATUS_SUCCESS;
 
+    // [CYCLE2-E002D] dump captured expert routing traces
+    if (!res->moe_trace.collected.empty() && g_llama_moe_trace != nullptr) {
+        ggml_backend_sched_synchronize(sched.get());
+        const llama_token * toks = ubatch.token;
+        for (const auto & entry : res->moe_trace.collected) {
+            const int32_t il = entry.first;
+            const std::vector<int32_t> & v = entry.second;
+            if (v.size() < 2) continue;
+            const int32_t ne0 = v[0];
+            const int64_t n_entries = (int64_t)(v.size() - 1);
+            if (ne0 <= 0 || n_entries % ne0 != 0) continue;
+            const int64_t ne1 = n_entries / ne0;
+            for (int64_t tok = 0; tok < ne1; tok++) {
+                const int tid = (toks != nullptr) ? (int)toks[tok] : -1;
+                fprintf(g_llama_moe_trace, "%d %d %d", tid, (int)il, (int)ne0);
+                for (int64_t k = 0; k < ne0; k++) {
+                    fprintf(g_llama_moe_trace, " %d", (int)v[1 + k * ne1 + tok]);
+                }
+                fprintf(g_llama_moe_trace, "\n");
+            }
+        }
+        fflush(g_llama_moe_trace);
+        res->moe_trace.collected.clear();
+    }
+    res->moe_trace.pending.clear();
+
     return res;
 }
 
